# Cloudflare Pages / Netlify security headers.
#
# Two eval permissions are required and cannot be removed:
#   'unsafe-eval'       mission generators and reference solutions are evaluated
#                       with new Function (src/data/content.js), and the
#                       JavaScript runner evaluates the player's own code.
#   'wasm-unsafe-eval'  Pyodide is WebAssembly.
# connect-src must name the execution service you actually use. It currently
# names wandbox.org (VITE_WANDBOX_URL=default). If you switch providers, change
# it: https://emkc.org for the public Piston, or your own Judge0 origin. A
# missing entry here fails ONLY in production — the dev server sends no CSP, so
# C++ and Java work locally and are blocked the moment you deploy.
# Read SECURITY.md before deploying.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net https://*.supabase.co https://wandbox.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/content/*
  Cache-Control: public, max-age=60, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
